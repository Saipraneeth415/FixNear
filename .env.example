# Copy this file to ".env" and change the values.  ".env" is ignored by Git.
# In PowerShell:  Copy-Item .env.example .env

# development | production | testing
APP_ENV=development

# Signs login sessions and CSRF tokens. Since Stage 4 this really matters:
# anyone who knows it could forge a login session. Use your own random value.
# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Set to 1 to enable Flask's debugger. NEVER enable this in production.
FLASK_DEBUG=0

# Minutes ahead of UTC for your customers' local time (330 = India, UTC+5:30).
# Used to reject appointments that are already in the past.
BOOKING_UTC_OFFSET_MINUTES=330

# Database. This SQLite value is the default and is stored in instance\fixnear.db.
# For a hosted database later, use a URL like one of these (never commit real passwords):
#   DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
#   DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL=sqlite:///fixnear.db
